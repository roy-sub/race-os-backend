###############################################################################
# RaceOS — environment configuration
#
# This file is the single source of truth for configuration. Every variable the
# application reads appears below; nothing else is read, and nothing here is
# unused. `backend/tests/unit/test_config_env_example.py` asserts that in both
# directions, so this file cannot drift from the code.
#
# Copy to `.env` at the repository root and fill in the values:
#     cp .env.example .env
# Then check it:
#     make check-env
#
# ---------------------------------------------------------------------------
# WHAT YOU NEED, AND WHEN
# ---------------------------------------------------------------------------
#
# LOCAL DEVELOPMENT — the test suite runs fully offline with no credentials at
# all. To run the API locally you need only:
#     DATABASE_URL ....................... a local Postgres with PostGIS
#     JWT_PRIVATE_KEY / JWT_PUBLIC_KEY ... generate a throwaway pair (below)
#     SESSION_COOKIE_SECRET .............. generate (below)
#     INTERNAL_JOB_SECRET ................ generate (below)
# Everything else has a working development default.
#
# RENDER (staging / production) — set every variable marked `# REQUIRED` in
# Render's environment settings. The app refuses to boot with any of them
# missing when APP_ENV is `staging` or `production`, and names the ones it
# could not find. Never commit a filled-in `.env`; `.gitignore` excludes it.
#
# WHERE VALUES COME FROM — see docs/CONFIGURATION.md. Only five sources exist:
# Supabase (database + storage), Stripe (payments), Open-Meteo (no key),
# Mapterhorn (no key), and three things you generate yourself.
###############################################################################


# =============================================================================
# APPLICATION
# =============================================================================

# Which environment this process is. `staging` and `production` enforce every
# REQUIRED variable at boot and forbid a CORS wildcard; `development` uses
# working defaults. Without it the app assumes development and will happily
# start half-configured in production.
# REQUIRED
APP_ENV=development

# Logging verbosity: CRITICAL | ERROR | WARNING | INFO | DEBUG. DEBUG logs
# every SQL statement's timing; it does not log secrets at any level.
# OPTIONAL (default: INFO)
LOG_LEVEL=INFO

# Public origin of the frontend. Every link the backend builds — password
# reset, email verification, share links — is rooted here. Wrong value sends
# your users to the wrong host; empty breaks password reset entirely.
# REQUIRED
APP_BASE_URL=https://raceos.pages.dev

# Public origin of this API. Used in generated OpenAPI servers and in absolute
# URLs returned to clients. Wrong value breaks the generated frontend client.
# REQUIRED
API_BASE_URL=https://raceos-api.onrender.com

# Comma-separated browser origins allowed to call this API. Must list the
# Cloudflare Pages origin and the custom domain. A wildcard is refused outside
# development. Wrong value makes every browser request fail CORS preflight.
# REQUIRED
CORS_ALLOWED_ORIGINS=https://raceos.pages.dev,https://app.raceos.example


# =============================================================================
# DATABASE — Supabase Postgres with PostGIS
# =============================================================================

# The Postgres connection string, with the `postgresql+psycopg://` driver
# prefix. Nothing works without it.
#
# Supabase gives you two forms and BOTH work here with no code change — the
# connection layer detects the pooler and adapts (transaction-mode pooling
# cannot use prepared statements, so it disables them and pools differently):
#
#   Direct     postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#   Pooler     postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# The direct host may be IPv6-only, which Render's outbound may not reach. If
# the direct form fails from Render, switch to the pooler form — that is the
# only change needed. Run `python scripts/check_supabase.py` to find out which
# form works and whether PostGIS is enabled, before deploying.
#
# Locally, a plain Postgres with PostGIS is fine:
#   postgresql+psycopg://raceos@localhost:5432/raceos_dev
# REQUIRED
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Connections held open per process. Supabase's pooler has its own ceiling;
# raising this past it produces connection errors under load, not throughput.
# OPTIONAL (default: 5)
DATABASE_POOL_SIZE=5

# Extra connections allowed above the pool size during a burst.
# OPTIONAL (default: 5)
DATABASE_MAX_OVERFLOW=5

# Seconds a request waits for a free connection before failing. Too high and a
# database stall becomes a request pile-up instead of a fast error.
# OPTIONAL (default: 30)
DATABASE_POOL_TIMEOUT_SECONDS=30

# Seconds to wait when opening a new connection. Keep it well under the
# solver's SLA so a database outage fails fast rather than eating the budget.
# OPTIONAL (default: 10)
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Server-side statement timeout in milliseconds, applied to every session. A
# runaway query is cancelled by the database rather than holding a connection.
# OPTIONAL (default: 30000)
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Echo every SQL statement to the log. Development debugging only; it is very
# noisy and slows request handling.
# OPTIONAL (default: false)
DATABASE_ECHO=false


# =============================================================================
# OBJECT STORAGE — Supabase Storage
#
# Storage only. Supabase Auth is NOT used: this application issues its own
# RS256 JWTs (see AUTHENTICATION below). There is no separate object-storage
# account and no OBJECT_STORAGE_* / R2 / S3 variables.
# =============================================================================

# Your Supabase project URL. Addresses both the database REST surface and
# storage. Without it no upload, export or avatar can be stored or served.
# REQUIRED
SUPABASE_URL=https://PROJECT_REF.supabase.co

# The Supabase secret (service-role) key. FULL ADMINISTRATIVE ACCESS to the
# project — treat it like a root password, never commit it, never log it, and
# never paste it into a chat transcript. Server-side only.
# REQUIRED
SUPABASE_SECRET_KEY=sb_secret_<xxxxxxxxxxxxxxxxxxxxxxxx>

# The Supabase publishable (anon) key. The backend does not use it; it is here
# so a single `.env` can also configure the frontend's storage reads. Safe to
# expose to browsers, unlike the key above.
# OPTIONAL (default: empty)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Private bucket for uploads and generated exports. Served only through
# short-lived signed URLs. Must exist in the project before first use.
# OPTIONAL (default: raceos-private)
SUPABASE_STORAGE_BUCKET_PRIVATE=raceos-private

# Public bucket for `assets/` media only. Nothing athlete-specific goes here.
# OPTIONAL (default: raceos-public)
SUPABASE_STORAGE_BUCKET_PUBLIC=raceos-public

# Lifetime in seconds of a signed upload or download URL. Shorter is safer;
# too short and a slow mobile upload expires mid-transfer.
# OPTIONAL (default: 3600)
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Seconds before a storage API call is abandoned.
# OPTIONAL (default: 30)
STORAGE_REQUEST_TIMEOUT_SECONDS=30

# CDN origin for the 41 catalogued media assets. Leave empty to serve straight
# from the public Supabase bucket. None of the assets exists yet: the API
# returns a clean 404 for a missing one and the frontend falls back to the
# course's `tone_color`, which is the specified behaviour.
# OPTIONAL (default: derived from SUPABASE_URL and the public bucket)
MEDIA_BASE_URL=


# =============================================================================
# AUTHENTICATION — our own RS256 keypair
#
# Generate a throwaway pair for development; generate a separate one for
# production and set it in Render. Never reuse a development key in production
# and never commit either.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#
# A PEM block is multi-line and a .env file is line-oriented, which is the
# single most common thing to get wrong here. Put the whole key on ONE line,
# in DOUBLE QUOTES, with literal `\n` between the lines. Convert each file to
# exactly that form with:
#
#   awk 'BEGIN{ORS="\\n"} 1' jwt_private.pem
#   awk 'BEGIN{ORS="\\n"} 1' jwt_public.pem
#
# then paste the output between the quotes below. (In Render's dashboard you
# may instead paste the real multi-line key into the multi-line editor; both
# forms are accepted and normalised.)
# =============================================================================

# Private key that signs access and refresh tokens. Without it nobody can log
# in. Anyone holding it can mint tokens for any account.
# REQUIRED
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQxxxxxxxxxxxxxx\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# Public key that verifies them. Must be the pair of the key above; a mismatch
# rejects every token with no useful error at the call site.
# REQUIRED
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAxxxxxxxxxxxxxxxxxxxx\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PUBLIC KEY-----\n"

# Access-token lifetime in seconds. Short by design; the refresh token carries
# the session. Long values widen the window in which a stolen token works.
# OPTIONAL (default: 900)
JWT_ACCESS_TTL_SECONDS=900

# Refresh-token lifetime in seconds. How long a signed-in device stays signed
# in without re-authenticating.
# OPTIONAL (default: 2592000)
JWT_REFRESH_TTL_SECONDS=2592000

# `iss` claim written into and checked on every token.
# OPTIONAL (default: raceos)
JWT_ISSUER=raceos

# `aud` claim written into and checked on every token.
# OPTIONAL (default: raceos-api)
JWT_AUDIENCE=raceos-api

# Signing secret for the refresh cookie. Generate 48 random bytes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every existing session out.
# REQUIRED
SESSION_COOKIE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name of the httpOnly refresh cookie.
# OPTIONAL (default: raceos_refresh)
SESSION_COOKIE_NAME=raceos_refresh

# Cookie domain. Leave empty to scope the cookie to the API host exactly,
# which is correct unless the API and frontend share a registrable domain.
# OPTIONAL (default: empty)
SESSION_COOKIE_DOMAIN=

# argon2id time cost. Higher is slower to crack and slower to log in. Raise
# these three together only against measured login latency on real hardware.
# OPTIONAL (default: 3)
ARGON2_TIME_COST=3

# argon2id memory cost in KiB. The main defence against GPU cracking. 65536 is
# 64 MiB per hash; make sure the instance has headroom for concurrent logins.
# OPTIONAL (default: 65536)
ARGON2_MEMORY_COST_KIB=65536

# argon2id parallelism, in lanes. Should not exceed the instance's available
# cores, or hashing contends with request handling and logins slow down.
# OPTIONAL (default: 4)
ARGON2_PARALLELISM=4

# Whether a verified email address is required before the first plan solve.
# FALSE in V1 because email delivery is a no-op: new accounts are created
# already verified. The whole verification flow is built and tested, so
# flipping this to true needs no code change — only a working email transport.
# OPTIONAL (default: false)
REQUIRE_EMAIL_VERIFICATION=false

# Hours an email-verification link stays valid.
# OPTIONAL (default: 48)
EMAIL_VERIFICATION_TTL_HOURS=48

# Minutes a password-reset link stays valid. Single-use; a successful reset
# also invalidates every other session on the account.
# OPTIONAL (default: 60)
PASSWORD_RESET_TTL_MINUTES=60

# Consecutive failed logins before an account locks. The failure message
# states the attempts remaining and must stay accurate, so changing this
# changes user-visible copy.
# OPTIONAL (default: 3)
LOGIN_MAX_ATTEMPTS=3

# Minutes an account stays locked after that.
# OPTIONAL (default: 15)
LOGIN_LOCK_MINUTES=15


# =============================================================================
# INTERNAL JOB ENDPOINTS
#
# V1 ships no scheduler. Every scheduled job is a service method exposed at
# /internal/jobs/{name} and called by an external cron (Render Cron, a GitHub
# Actions schedule, or any HTTP cron service). The README documents the
# intended schedule for each.
# =============================================================================

# Shared secret required in the `X-Internal-Job-Secret` header on every
# /internal/jobs/* call. Generate 48 random bytes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding it can trigger any background job. Without it those endpoints
# reject every request and no scheduled work ever runs.
# REQUIRED
INTERNAL_JOB_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# PAYMENTS — Stripe (test mode in V1)
#
# Placeholders below are wrapped in <angle brackets> so they cannot be mistaken
# for real keys by a secret scanner. Replace the whole token INCLUDING the
# brackets.
# =============================================================================

# Stripe secret key. Server-side only. Payments cannot be authorized or
# captured without it. Test-mode keys begin `sk_test_`.
# REQUIRED
STRIPE_SECRET_KEY=sk_test_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Stripe publishable key, handed to the browser to tokenize a card. Safe to
# expose. Test-mode keys begin `pk_test_`.
# REQUIRED
STRIPE_PUBLISHABLE_KEY=pk_test_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Signing secret for the payments webhook, from the Stripe dashboard AFTER you
# register the endpoint against the deployed URL. Without it every inbound
# webhook fails signature verification and subscription state goes stale.
# REQUIRED
STRIPE_WEBHOOK_SECRET=whsec_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Price ID for the single-race plan (£15 / $19 / €18).
# REQUIRED
STRIPE_PRICE_ID_RACE_PLAN=price_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Price ID for the season pass (£47 / $59 / €55).
# REQUIRED
STRIPE_PRICE_ID_SEASON_PASS=price_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Price ID for the coach tier (£79 / $99 / €92).
# REQUIRED
STRIPE_PRICE_ID_COACH=price_<xxxxxxxxxxxxxxxxxxxxxxxx>

# Seconds before a Stripe API call is abandoned. Keep it below the checkout
# request budget so a Stripe stall fails cleanly rather than hanging.
# OPTIONAL (default: 20)
STRIPE_REQUEST_TIMEOUT_SECONDS=20


# =============================================================================
# WEATHER — Open-Meteo
#
# Open-Meteo needs NO API KEY. There is deliberately no WEATHER_PROVIDER_API_KEY
# variable; if you find yourself wanting one, the implementation is wrong.
# =============================================================================

# Base URL of the Open-Meteo forecast API. Change only to point at a
# self-hosted mirror or the commercial endpoint.
# OPTIONAL (default: https://api.open-meteo.com/v1)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# How far ahead a race must be before its forecast is ingested. Beyond this a
# forecast is noise, and pretending otherwise produces drift events that are
# not real information.
# OPTIONAL (default: 72)
WEATHER_FORECAST_HORIZON_HOURS=72

# Seconds before a forecast request is abandoned.
# OPTIONAL (default: 15)
WEATHER_REQUEST_TIMEOUT_SECONDS=15

# Minutes a fetched forecast is reused before refetching. Backed by a database
# table with a TTL column plus a small in-process cache — there is no Redis.
# OPTIONAL (default: 180)
FORECAST_CACHE_TTL_MINUTES=180


# =============================================================================
# TERRAIN TILES — hosted Mapterhorn (frontend map)
#
# No key. A base URL only, handed to the frontend so MapLibre can stream
# Terrarium-encoded PMTiles.
# =============================================================================

# Base URL serving the terrain PMTiles. Empty means the 3D map and hillshade
# render flat.
# REQUIRED
TERRAIN_PMTILES_BASE_URL=https://demo.mapterhorn.com


# =============================================================================
# SOLVER
# =============================================================================

# Hard end-to-end SLA in milliseconds. Shown on the Admin dashboard against
# real measured percentiles. Exceeding it alerts; it never aborts a solve.
# OPTIONAL (default: 6000)
SOLVER_SLA_MS=6000

# Milliseconds a solve may run inside the request before it is handed to a
# background task and the caller gets 202 with a job id. Must not exceed
# SOLVER_SLA_MS. The synchronous path is the default; this is the escape hatch.
# OPTIONAL (default: 5000)
SOLVER_SYNC_BUDGET_MS=5000

# Target median solve latency in milliseconds. Alerting threshold only.
# OPTIONAL (default: 3100)
SOLVER_TARGET_P50_MS=3100

# Target 95th-percentile solve latency in milliseconds. Alerting threshold
# only; must not exceed SOLVER_SLA_MS.
# OPTIONAL (default: 5400)
SOLVER_TARGET_P95_MS=5400


# =============================================================================
# PHRASING LAYER
#
# FALSE in V1. The deterministic template fallback for every message type is
# the shipping path, and it returns every correct number in plainer prose. The
# LLM adapter and its boundary guards are built, so enabling it later is a
# config change.
# =============================================================================

# Whether to call the language model for prose. When false, templates are used
# everywhere and no external model is contacted.
# OPTIONAL (default: false)
PHRASING_ENABLED=false

# Milliseconds before a phrasing call is abandoned and the template used
# instead. A slow model must never delay a plan.
# OPTIONAL (default: 2500)
PHRASING_TIMEOUT_MS=2500

# Model identifier for the phrasing adapter. Unused while PHRASING_ENABLED is
# false; required if you turn it on.
# OPTIONAL — V2 (default: empty)
PHRASING_MODEL_ID=

# API key for the phrasing model. Unused in V1 and intentionally unset: no
# such account is part of this build. Required if you turn phrasing on.
# OPTIONAL — V2 (default: empty)
PHRASING_MODEL_API_KEY=


# =============================================================================
# EMAIL
#
# The subsystem is fully built — templates, preference matrix, notification
# fan-out. Only the transport is a no-op: `logging` renders each message in
# full to structured logs and records it in the database. In-app notifications
# are the live V1 delivery channel.
# =============================================================================

# Whether to hand messages to a real transport. FALSE in V1. Flipping it to
# true with EMAIL_TRANSPORT=logging still sends nothing, by design.
# OPTIONAL (default: false)
EMAIL_ENABLED=false

# Which sender implementation to bind: logging | resend | postmark. `logging`
# is the V1 transport and needs no account.
# OPTIONAL (default: logging)
EMAIL_TRANSPORT=logging

# From-address stamped on every rendered message, including logged ones. It
# appears in the message body, so it must be right even with email disabled.
# REQUIRED
EMAIL_FROM_ADDRESS=noreply@raceos.example

# Display name beside that address.
# OPTIONAL (default: RaceOS)
EMAIL_FROM_NAME=RaceOS

# API key for the real email provider. Unused in V1 and intentionally unset:
# no email account is part of this build. Required only if you set
# EMAIL_TRANSPORT to resend or postmark and EMAIL_ENABLED to true.
# OPTIONAL — V2 (default: empty)
EMAIL_PROVIDER_API_KEY=


# =============================================================================
# WEB PUSH
#
# Built and disabled in V1. Sending is inline; no queue is needed at this
# volume. Generate a VAPID keypair with the `vapid` CLI that ships with
# pywebpush:
#     vapid --gen                       # writes private_key.pem / public_key.pem
#     vapid --applicationServerKey      # prints the base64url public key
# =============================================================================

# Whether push subscriptions are accepted and pushes sent.
# OPTIONAL (default: false)
PUSH_ENABLED=false

# base64url-encoded VAPID public key, handed to the browser when it subscribes.
# OPTIONAL (default: empty)
VAPID_PUBLIC_KEY=

# VAPID private key, PEM, same one-line quoting as the JWT keys above.
# Required only when PUSH_ENABLED is true.
# OPTIONAL (default: empty)
VAPID_PRIVATE_KEY=

# Contact URI a push service can use to reach you about your pushes. Must be a
# `mailto:` or `https:` URI.
# OPTIONAL (default: mailto:noreply@raceos.example)
VAPID_SUBJECT=mailto:noreply@raceos.example


# =============================================================================
# PRODUCT THRESHOLDS
#
# Every number the specification names is a config value, never a literal in a
# conditional, so these tune without a deploy.
# =============================================================================

# Weekdays on which publishing a course bundle is refused, evaluated in UTC.
# The freeze exists so a bundle cannot move under an athlete in race week.
# OPTIONAL (default: Thu,Fri,Sat,Sun)
COURSE_BUNDLE_FREEZE_DAYS=Thu,Fri,Sat,Sun

# Agreeing independent uploads before a crowd report can be promoted.
# OPTIONAL (default: 40)
CROWD_VERIFIED_MIN_UPLOADS=40

# Uploads needed for `high` crowd confidence, with the agreement below.
# OPTIONAL (default: 30)
CROWD_CONFIDENCE_HIGH_UPLOADS=30

# Agreement percentage needed for `high` crowd confidence.
# OPTIONAL (default: 65)
CROWD_CONFIDENCE_HIGH_AGREEMENT_PCT=65

# Below this many uploads a crowd report is `low` confidence. Must be under
# CROWD_CONFIDENCE_HIGH_UPLOADS or the `med` band is empty.
# OPTIONAL (default: 15)
CROWD_CONFIDENCE_LOW_UPLOADS=15

# Minutes a projected split must move before it counts as drift. Lower values
# notify more often; this is the number the product's own copy quotes.
# OPTIONAL (default: 2)
DRIFT_SPLIT_THRESHOLD_MINUTES=2

# Barrier margin in minutes below which drift is escalated to `cutoff_risk`.
# Also the boundary between `clear` and `tight` margin states.
# OPTIONAL (default: 20)
DRIFT_MARGIN_RISK_MINUTES=20

# Days after which a tested or measured constraint is considered stale and a
# STALE_DATA warning rides alongside the response.
# OPTIONAL (default: 180)
CONSTRAINT_STALENESS_DAYS_DEFAULT=180

# Hours after an athlete's projected finish that notifications stay suppressed.
# The window starts at wave start and overrides every per-type preference,
# because Race Mode's stated promise is no notifications during a race.
# OPTIONAL (default: 3)
RACE_NOTIFICATION_SUPPRESSION_BUFFER_HOURS=3

# Minutes a support access grant stays live once the athlete approves it.
# Non-renewable without fresh approval.
# OPTIONAL (default: 60)
SUPPORT_GRANT_TTL_MINUTES=60

# Random bytes in a share-link token. 16 bytes is 128 bits of entropy, the
# documented floor. The frontend mock's six-character code is not the scheme.
# OPTIONAL (default: 16)
SHARE_TOKEN_BYTES=16

# Largest accepted upload in bytes (20 MiB). Covers race files, GPX and
# avatars.
# OPTIONAL (default: 20971520)
UPLOAD_MAX_BYTES=20971520

# Athletes one coach seat may hold.
# OPTIONAL (default: 15)
COACH_MAX_ATHLETES=15


# =============================================================================
# RATE LIMITING AND CACHING
#
# Both are database-backed. There is no Redis in V1. Rate-limit counters are
# per-instance-safe because exactly one web instance runs; moving to more than
# one instance means moving these counters somewhere shared, and that is
# recorded in docs/DECISIONS.md rather than left to be discovered.
# =============================================================================

# Master switch for rate limiting. Disable only in local development.
# OPTIONAL (default: true)
RATE_LIMIT_ENABLED=true

# Requests per minute per account for ordinary endpoints.
# OPTIONAL (default: 120)
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Requests per minute for auth endpoints, per account and per IP. This is the
# defence in depth behind the login lockout.
# OPTIONAL (default: 10)
RATE_LIMIT_AUTH_PER_MINUTE=10

# Attempts per minute at a share link's optional human-typed access code. That
# code is only ever a second factor; this is what stops it being brute-forced.
# OPTIONAL (default: 5)
RATE_LIMIT_SHARE_CODE_PER_MINUTE=5

# Hours a stored idempotency key and its recorded response are replayable.
# OPTIONAL (default: 24)
IDEMPOTENCY_KEY_TTL_HOURS=24

# Seconds a published course bundle is cached in process. Bundles are
# immutable once published, so this is safe to raise; 0 disables it.
# OPTIONAL (default: 300)
COURSE_BUNDLE_CACHE_TTL_SECONDS=300
