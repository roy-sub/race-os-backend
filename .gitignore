# Environment — never commit a filled-in .env. `.env.example` is committed and
# is the template; everything below it is a real credential file.
.env
.env.*
!.env.example

# Generated keypairs. These are produced locally by the commands in
# .env.example and must never enter the repository.
*.pem
jwt_private.pem
jwt_public.pem
private_key.pem
public_key.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local database dumps and scratch
*.sqlite3
*.dump
scratch/
.venv
